with open(r"C:\Users\sahas\OneDrive\Desktop\vscode\Python\python_fundamentals_5\sample.txt", "r") as f:
    lines=f.readlines()
    num=1
    for line in lines:
        word=line.split()
        if("Digital" in word):
            print(f"word found at line {num}")
        num=num+1